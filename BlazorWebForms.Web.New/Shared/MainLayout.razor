@using BlazorWebForms.Web.Common.Web
@using Microsoft.AspNetCore.Authentication;
@using BlazorWebForms.Web.SharedComponents.Components;

@inherits LayoutComponentBase

<AppProvider/>
<PageTitle>Web New</PageTitle>

<div class="page">

    <AppHeader LogoutPath="@ApiPaths.Logout" IsAuthenticated="@IsAuthenticated"/>
    <main>
        <article class="content px-4">
            @Body
        </article>
    </main>
</div>

@code 
{
    [CascadingParameter]
    private Task<AuthenticationState>? AuthenticationState { get; set; }

    private bool IsAuthenticated { get; set; }

    protected override async Task OnInitializedAsync()
    {
        if (AuthenticationState is null)
        {
            return;
        }

        var authState = await AuthenticationState;

        IsAuthenticated = authState?.User?.Identity is not null && authState.User.Identity.IsAuthenticated;
    }
}
