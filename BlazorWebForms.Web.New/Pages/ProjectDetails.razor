@using BlazorWebForms.UseCases.GetProjectId
@using Common
@using BlazorWebForms.Web.Common.Web
@using MediatR

@attribute [Route(NewAppPaths.ProjectDetailsTemplate)]
@attribute [Authorize]

<MudIconButton 
    Href="@BlazorAppUrlBuilder.BuildLegacyAppUrl(LegacyAppPaths.ProjectsPath)" 
    Icon="@Icons.Material.Filled.ArrowBack"/>

<div class="container">
    @if (Project is not null)
    {
        <div class="project">
            <p>Project name: @Project.Name</p>
            <p>Project user: @Project.UserName</p>
        </div>
    }
    else
    {
        <MudProgressCircular />
    }
</div>

@code {

    private ProjectDetailsDto? Project { get; set; }

    [Inject]
    private IMediator Mediator { get; set; } = null!;

    [Inject]
    private AppUrlBuilder BlazorAppUrlBuilder { get; set; } = null!;

    [Parameter]
    public int Id { get; set; }

    protected override async Task OnInitializedAsync()
    {
        Project = await Mediator.Send(new GetProjectsByIdQuery(Id));
        
        await base.OnInitializedAsync();
    }
}