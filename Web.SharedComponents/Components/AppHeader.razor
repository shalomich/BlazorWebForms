@using Common.Web
<div class="header-wrapper">
    <MudAppBar Class="header">
        <MudStack Row="true"
        Justify="Justify.SpaceBetween"
        AlignItems="AlignItems.Center"
        Class="header-container">
            <MudStack Row="true"
            Spacing="4"
            AlignItems="AlignItems.Center">
                <MudImage Src="/components/images/eternal-me-logo.png"
                Class="logo" />
                <MudText>App Title</MudText>
            </MudStack>
            @if (IsAuthenticated)
            {
                <form method="post" action="@AppUrlBuilder.BuildNewAppUrl(NewAppPaths.Logout)">
                    <MudButton ButtonType="ButtonType.Submit"
                               Color="Color.Primary"
                               Variant="Variant.Filled">
                        Logout
                    </MudButton>
                </form>
            }
        </MudStack>
    </MudAppBar>
</div>

@code 
{
    [Inject]
    private AppUrlBuilder AppUrlBuilder { get; set; } = null!;
}