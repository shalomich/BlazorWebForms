@using Common.Web

<div class="header-wrapper">
    <MudAppBar Class="header">
        <MudStack Row="true"
        Justify="Justify.SpaceBetween"
        AlignItems="AlignItems.Center"
        Class="header-container">
            <MudStack Row="true"
            Spacing="4"
            AlignItems="AlignItems.Center">
                <MudImage Src="/components/images/eternal-me-logo.png"
                Class="logo" />
                <MudText>App Title</MudText>
            </MudStack>
            @if (IsAuthenticated)
            {
                <MudButton Color="Color.Primary"
                Variant="Variant.Filled"
                OnClick="Logout">
                    Logout
                </MudButton>
            }
        </MudStack>
    </MudAppBar>
</div>

@code 
{
    [Inject]
    private AppUrlBuilder AppUrlBuilder { get; set; } = null!;

    [Inject]
    private NavigationManager NavigationManager { get; set; } = null!;

    [Inject]
    private HttpClient HttpClient { get; set; } = null!; 

    [Inject]
    private MudTheme Theme { get; set; } = null!;

    [Parameter]
    public string LogoutPath { get; set; } = string.Empty;

    [Parameter]
    public bool IsAuthenticated { get; set; }

    protected async Task Logout()
    {
        await HttpClient.PostAsync(ApiPaths.Logout, content: null);

        NavigationManager.NavigateTo(AppUrlBuilder.BuildLegacyAppUrl(LegacyAppPaths.LoginPath), forceLoad: true);
    }
}