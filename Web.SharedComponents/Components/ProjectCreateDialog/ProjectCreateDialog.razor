@using Common.Dtos
@using Common.Web
@using System.ComponentModel.DataAnnotations
<div class="dialog">
    <form action="@AppUrlBuilder.BuildNewAppUrl(NewAppPaths.Projects)" 
          method="post">
        <MudStack Spacing="2">
            <MudTextField Label="Name *"
                          Variant="Variant.Outlined"
                          For="@(() => Model.Name)"
                          name="@nameof(Model.Name)"
                          @bind-Value="Model.Name"/>
            <MudSelect Label="User *"
                       Variant="Variant.Outlined"
                       For="@(() => Model.UserId)"
                       name="@nameof(Model.UserId)"
                       @bind-Value="Model.UserId">
                @foreach (var user in Users)
                {
                    <MudSelectItem Value="user.Id">@user.Name</MudSelectItem>
                }
            </MudSelect>
            <MudButton ButtonType="ButtonType.Submit"
                       Variant="Variant.Filled"
                       Color="Color.Primary"
                       Disabled="!IsValid">
                Save
            </MudButton>
        </MudStack>
    </form>
</div>

@code 
{
    private ProjectCreateDto Model { get; } = new();

    private bool IsValid => Validator.TryValidateObject(Model, new(Model), []);

    [Inject]
    private AppUrlBuilder AppUrlBuilder { get; set; } = null!;

    [Parameter]
    public IEnumerable<UserDto> Users { get; set; } = [];
}