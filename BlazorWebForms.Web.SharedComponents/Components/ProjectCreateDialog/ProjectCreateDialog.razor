@using BlazorWebForms.UseCases.CreateProject
@using BlazorWebForms.UseCases.GetUsers
@using BlazorWebForms.Web.Common.Web
@using System.ComponentModel.DataAnnotations
<div class="dialog">
    <EditForm Model="Model" OnValidSubmit="CreateProject">
        <DataAnnotationsValidator />
        <MudStack Spacing="2">
            <MudTextField Label="Name *"
            Variant="Variant.Outlined"
            For="@(() => Model.Name)"
            @bind-Value="Model.Name"/>
            <MudSelect Label="User *"
            Variant="Variant.Outlined"
            For="@(() => Model.UserId)"
            @bind-Value="Model.UserId">
                @foreach (var user in Users)
                {
                    <MudSelectItem Value="user.Id">@user.Name</MudSelectItem>
                }
            </MudSelect>
            <MudButton ButtonType="ButtonType.Submit"
            Variant="Variant.Filled"
            Color="Color.Primary">
                Save
            </MudButton>
        </MudStack>
    </EditForm>
</div>

@code 
{
    private ProjectCreateDto Model { get; } = new();

    [Inject]
    private HttpClient HttpClient { get; set; } = null!;

    [Inject]
    private NavigationManager NavigationManager { get; set; } = null!;

    [Inject]
    private AppUrlBuilder AppUrlBuilder { get; init; } = null!;

    [CascadingParameter]
    private MudDialogInstance Dialog { get; set; } = null!;

    [Parameter]
    public IEnumerable<UserDto> Users { get; set; } = [];

    private async Task CreateProject() 
    {
        await HttpClient.PostAsync(AppUrlBuilder.BuildNewAppUrl(ApiPaths.CreateProject), JsonContent.Create(Model));

        Dialog.Close();

        NavigationManager.NavigateTo(AppUrlBuilder.BuildLegacyAppUrl(LegacyAppPaths.ProjectsPath), forceLoad: true);
    }
}